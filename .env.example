# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Path to the SQLite database file
DATABASE_PATH=./teleplay.sqlite

# Hours before a match's scheduled time that a reminder should be sent
REMINDER_LEAD_HOURS=3

# How often (minutes) the reminder worker polls for due reminders
REMINDER_POLL_INTERVAL_MINUTES=1

# How long (minutes) a candidate has to accept an invitation queue offer before it expires
INVITATION_TIMEOUT_MINUTES=60

# How often (minutes) the invitation queue expiry worker polls for expired invitations
INVITATION_POLL_INTERVAL_MINUTES=1

# webhook (default, for an always-on deployment) or polling (local dev only — webhooks need a
# publicly reachable HTTPS URL, e.g. via an ngrok-style tunnel, so polling is simpler locally)
BOT_MODE=webhook

# Port the webhook HTTP server listens on (ignored in polling mode)
PORT=8080

# Publicly reachable base URL for this bot, no trailing slash (e.g. https://bot.example.com).
# Required when BOT_MODE=webhook.
PUBLIC_URL=

# Path Telegram will POST updates to; combined with PUBLIC_URL when registering the webhook
WEBHOOK_PATH=/telegram/webhook

# Shared secret Telegram sends back as X-Telegram-Bot-Api-Secret-Token on every webhook request.
# Required when BOT_MODE=webhook. Generate one with: openssl rand -hex 32
WEBHOOK_SECRET_TOKEN=
